<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Vdb</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Cristian</Authors>
    <Description>Embedded vector database for .NET: HNSW index and memory-mapped segments over a native C++ engine.</Description>
    <RepositoryUrl>https://github.com/ctj01/vdb</RepositoryUrl>
  </PropertyGroup>

  <!-- Native engine per runtime. win-x64 today; linux-x64 / osx-arm64 land
       via the CI matrix with the same layout. -->
  <ItemGroup>
    <None Include="..\..\build-msvc\src\Release\vdb_c.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>

</Project>
